# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). Never commit .env.local.

# Project URL, e.g. https://abcdefghijkl.supabase.co (nothing after .co)
NEXT_PUBLIC_SUPABASE_URL=

# The "publishable" key (older projects call it the "anon public" key).
# It is safe in the browser because Row Level Security protects the data.
# NEVER put the "secret" / "service_role" key in this app's env files.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Three throwaway accounts used only by the automated security tests.
# Create them through the app's sign-up page (see docs/SETUP.md).
# Supabase rejects @example.com: use plus-addresses of a real mailbox,
# e.g. yourname+testa@gmail.com.
# Never use your real account or a real password here.
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=
# Test C must never join a campaign by hand: tests use it as the outsider.
TEST_USER_C_EMAIL=
TEST_USER_C_PASSWORD=
